* {
    font: "Liberation Mono Bold 11";
    
    background:   #fafafa4b;
    foreground:   #000000;

    selected-bg:  #81818148;
    selected-fg:  #18160f;

    border-color: #000000;

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 500px;

    location: south;
    anchor: south;
    y-offset: -35px;

    background-color: @background;

    border: 2px;
    border-color: @border-color;
    border-radius: 5px;
}

mainbox {
    children: [ listview ];

    padding: 4px;

    background-color: @background;
}

listview {
    columns: 1;
    lines: 8;

    fixed-height: false;
    dynamic: true;

    spacing: 1px;
    scrollbar: false;

    background-color: @background;
}

element {
    padding: 6px 8px;

    border: 1px;
    border-color: transparent;

    border-radius: 5px;

    background-color: @background;
    text-color: @foreground;
}

element normal.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;

    border-color: @border-color;
}

element-text {
    background-color: inherit;
    text-color: inherit;

    vertical-align: 0.5;
}